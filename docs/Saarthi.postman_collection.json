{
  "info": {
    "name": "Saarthi API",
    "description": "Run in order. 1) Health  2) Login (admin) \u2013 saves the token automatically  3) any other request.\nSet the variable baseUrl to your Render address (e.g. https://saarthi-xxxx.onrender.com/api) or http://localhost:3000/api",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": "PUT-YOUR-ADMIN-PASSWORD-HERE"
    }
  ],
  "item": [
    {
      "name": "0. System",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('ok true', () => pm.expect(pm.response.json().ok).to.eql(true));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Login \u2013 supreme admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kind\": \"authority\",\n  \"username\": \"admin\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test('login ok', () => pm.expect(j.ok).to.eql(true));",
                  "pm.collectionVariables.set('token', j.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login \u2013 citizen",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kind\": \"citizen\",\n  \"phone\": \"9876543210\",\n  \"password\": \"YourStrong@Pass1\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test('login ok', () => pm.expect(j.ok).to.eql(true));",
                  "pm.collectionVariables.set('token', j.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login \u2013 officer (roll ID)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kind\": \"officer\",\n  \"empId\": \"PB-23-000001\",\n  \"password\": \"officer@123\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test('login ok', () => pm.expect(j.ok).to.eql(true));",
                  "pm.collectionVariables.set('token', j.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login \u2013 wrong password (expect 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kind\": \"authority\",\n  \"username\": \"admin\",\n  \"password\": \"wrong\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register citizen",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Weak password -> 400. Duplicate phone/email/Aadhaar -> 409.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Citizen\",\n  \"phone\": \"9876543210\",\n  \"email\": \"you@gmail.com\",\n  \"password\": \"YourStrong@Pass1\",\n  \"aadhaar\": \"<valid 12-digit Aadhaar>\",\n  \"ulb\": \"rajpura\",\n  \"ward\": 3,\n  \"district\": \"patiala\",\n  \"address\": \"House 1, Rajpura\",\n  \"pincode\": \"140401\",\n  \"gender\": \"Male\",\n  \"dob\": \"2000-01-01\",\n  \"profession\": \"Student\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Register \u2013 weak password (expect 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test\",\n  \"phone\": \"9876543211\",\n  \"email\": \"a@b.com\",\n  \"password\": \"weak\",\n  \"aadhaar\": \"x\",\n  \"ulb\": \"rajpura\",\n  \"ward\": 3\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Forgot password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/forgot-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "forgot-password"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"9876543210\",\n  \"email\": \"you@gmail.com\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Reset password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/reset-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "reset-password"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"<token from the e-mail link>\",\n  \"password\": \"NewStrong@Pass2\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Resend verification e-mail (citizen token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/resend-verification",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "resend-verification"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Change password (admin accounts)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/change-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "change-password"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current\": \"old\",\n  \"next\": \"newpass123\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Data (needs token)",
      "item": [
        {
          "name": "Get everything I may see",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/db",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "db"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get only if changed (rev)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/db?rev=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "db"
              ],
              "query": [
                {
                  "key": "rev",
                  "value": "1"
                }
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Write a collection (admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/db/notify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "db",
                "notify"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"value\": {\n    \"message\": \"Hello from Postman\"\n  }\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Next application number",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/seq/seq",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "seq",
                "seq"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Grievance tracking",
      "item": [
        {
          "name": "Track grievance (public)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/track",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "track"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appNo\": \"2601000001\",\n  \"phone\": \"9876543210\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "4. Uploads",
      "item": [
        {
          "name": "Upload file (form-data: file)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/upload",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "upload"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "5. Admin",
      "item": [
        {
          "name": "Run escalation check now (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/run-escalations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "run-escalations"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}