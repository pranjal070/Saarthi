# Copy this file to ".env" and fill it in. NEVER commit .env, zip it, or paste it in chat.
MONGO_URI=
JWT_SECRET=
PORT=3000
ADMIN_PASSWORD=

# Secret key for the one-way Aadhaar hash. 32+ random characters. Back it up privately and NEVER change it
# (changing it makes old hashes unmatchable, so duplicate-Aadhaar protection breaks).
AADHAAR_PEPPER=

# Public address of the site, used in the links inside emails (no trailing slash)
PUBLIC_URL=http://localhost:3000

# Email (SMTP). Leave MAIL_HOST empty to run in TEST MODE: emails are saved in backend/outbox/ instead of being sent.
MAIL_HOST=
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=
# Where admin alerts (new registration / new grievance) go. Empty = same as MAIL_USER
ADMIN_NOTIFY_EMAIL=
MAIL_FROM="Saarthi <no-reply@yourdomain.com>"

# true = a citizen must verify the email before filing a grievance
REQUIRE_EMAIL_VERIFY=true

# production on Render: set NODE_ENV=production (CORS then allows only PUBLIC_URL)
NODE_ENV=
# how often the server checks for SLA breaches (minutes)
ESCALATION_MINUTES=10
